{
  "workflows": [
    {
      "id": "wf-late-orders",
      "name": "Late Order Identification",
      "description": "Look up late-order policy then query ops for orders past promised delivery",
      "trigger_patterns": ["orders are late", "late as of", "which orders are late"],
      "expected_tools": ["rag_search", "ops_find_late_orders"],
      "nodes": [
        {"id": "start", "type": "start", "label": "Start"},
        {"id": "policy", "type": "tool", "label": "Get late order policy", "tool_name": "rag_search"},
        {"id": "query", "type": "tool", "label": "Find late orders", "tool_name": "ops_find_late_orders"},
        {"id": "summarize", "type": "llm", "label": "Summarize late orders"},
        {"id": "end", "type": "end", "label": "End"}
      ],
      "edges": [
        {"source": "start", "target": "policy"},
        {"source": "policy", "target": "query"},
        {"source": "query", "target": "summarize"},
        {"source": "summarize", "target": "end"}
      ]
    },
    {
      "id": "wf-part-investigation",
      "name": "Part History Investigation",
      "description": "Trace a part's event timeline and linked orders",
      "trigger_patterns": ["what happened to part", "part history", "trace part"],
      "expected_tools": ["ops_get_part_history", "ops_find_orders_by_part"],
      "nodes": [
        {"id": "start", "type": "start", "label": "Start"},
        {"id": "history", "type": "tool", "label": "Part timeline", "tool_name": "ops_get_part_history"},
        {"id": "orders", "type": "tool", "label": "Linked orders", "tool_name": "ops_find_orders_by_part"},
        {"id": "report", "type": "llm", "label": "Explain events"},
        {"id": "end", "type": "end", "label": "End"}
      ],
      "edges": [
        {"source": "start", "target": "history"},
        {"source": "history", "target": "orders"},
        {"source": "orders", "target": "report"},
        {"source": "report", "target": "end"}
      ]
    },
    {
      "id": "wf-order-delay",
      "name": "Order Delay Root Cause",
      "description": "Investigate order delay via shipment and part events",
      "trigger_patterns": ["why is order", "delayed", "order delay"],
      "expected_tools": ["ops_get_order", "ops_get_shipment", "ops_get_part_history"],
      "nodes": [
        {"id": "start", "type": "start", "label": "Start"},
        {"id": "order", "type": "tool", "label": "Get order", "tool_name": "ops_get_order"},
        {"id": "shipment", "type": "tool", "label": "Shipment status", "tool_name": "ops_get_shipment"},
        {"id": "parts", "type": "tool", "label": "Part events", "tool_name": "ops_get_part_history"},
        {"id": "diagnose", "type": "llm", "label": "Diagnose delay"},
        {"id": "end", "type": "end", "label": "End"}
      ],
      "edges": [
        {"source": "start", "target": "order"},
        {"source": "order", "target": "shipment"},
        {"source": "shipment", "target": "parts"},
        {"source": "parts", "target": "diagnose"},
        {"source": "diagnose", "target": "end"}
      ]
